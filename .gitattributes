# 统一换行符。shell 脚本必须是 LF，否则在 Linux/NAS 上会报
# "bad interpreter: /usr/bin/env bash^M" 这类错误。
* text=auto eol=lf

*.sh            text eol=lf
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

*.py            text eol=lf
*.js            text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
Dockerfile      text eol=lf
*.dockerignore  text eol=lf
.gitignore      text eol=lf
.env.example    text eol=lf

# 二进制
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.zip           binary
*.tar           binary
*.gz            binary
*.mp3           binary
*.flac          binary
*.m4a           binary

# 让 GitHub 语言统计把它认成 Python 项目
monitor/web/app.js  linguist-vendored=false

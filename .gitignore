# ── 密钥与本地配置（绝不入库）────────────────────────────────────────────
.env
.env.local

# ── 运行时数据：只保留目录占位，内容一律不入库 ────────────────────────────
# data/ 里是音乐文件、监控数据库、引擎的 Cookie 登录态，全部属于本机私密数据
data/*
!data/downloads/
!data/monitor/
data/downloads/*
data/monitor/*
!data/downloads/.gitkeep
!data/monitor/.gitkeep

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ── 构建 / 发布中间产物 ───────────────────────────────────────────────────
*.tar
.mmtmp/

# ── 系统杂项 ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ── 防御性兜底：万一有人在项目内跑 gh 等 CLI，别把登录态带进仓库 ──────────
# （实际的 gh 便携工具已移到项目外的 Ai项目库\.gh\）
.tools/
.config/
.local/
.cache/

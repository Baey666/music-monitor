# 复制为 .env 后按需修改，全部可留空使用默认值

# ── 镜像仓库 ────────────────────────────────────────────────────────────────
# 只有「推送到仓库后再部署」这一种用法需要改。
# 换成你自己的仓库地址，例如：
#   Docker Hub        yourname/music-monitor:latest
#   阿里云 ACR        registry.cn-hangzhou.aliyuncs.com/yournamespace/music-monitor:latest
#   腾讯云 TCR        ccr.ccs.tencentyun.com/yournamespace/music-monitor:latest
#   私有 registry     192.168.1.10:5000/music-monitor:latest
#
# Docker Hub 特别注意：它的地址**不带**仓库主机名，第一段就是你的 Docker ID（或组织名）。
#   · 推送前先登录： ./scripts/build-push.sh login
#     密码要填 Access Token，不是网页登录密码。
#   · 国内直连 hub.docker.com 经常超时，拉取建议配镜像加速，见 README「国内网络注意事项」。
#   · 免费账号私有仓库只能有 1 个，公开仓库数量不限（别人的拉取次数不计入你的限额）。
MONITOR_IMAGE=music-monitor:latest

# 构建与推送时使用的镜像地址（可留空，留空则取 MONITOR_IMAGE）
# 用于 buildx 多架构推送；与 MONITOR_IMAGE 分开是为了让"构建机"和"NAS"
# 可以用不同的地址（例如构建机推 Docker Hub，NAS 从内网 registry 拉）
BUILD_IMAGE=

# buildx 输出的目标架构，逗号分隔。NAS 是 x86_64 就只留 amd64，树莓派/ARM NAS 加 arm64
# 同时构建两个架构需要 QEMU 模拟，会慢很多；只在 NAS 上本机构建则无需设置此项
PLATFORMS=linux/amd64,linux/arm64

# ── 构建期源加速（国内构建强烈建议打开）────────────────────────────────────
# ⚠️ 这里只管「构建过程」用的源，和拉基础镜像不是一回事：
#    · 拉 python:3.12-slim / guohuiyuan/go-music-dl 走 Docker 守护进程的 registry-mirrors
#      （Docker Hub 在国内经常直接超时，必须配，见 docs/deploy.md「国内网络注意事项」）
#    · 下面两项管的是构建容器内部的 apt 和 pip
#
# APT_MIRROR  替换 Debian 软件源，留空用官方源。常用：mirrors.aliyun.com
# PIP_INDEX   替换 PyPI 源，留空用官方源。常用：https://pypi.tuna.tsinghua.edu.cn/simple
#
# 在国内 NAS 上就地构建时，把下面两行填上：
APT_MIRROR=
PIP_INDEX=

# ── 端口与行为 ──────────────────────────────────────────────────────────────
# 宿主机映射端口
ENGINE_PORT=8085          # 上游 go-music-dl 的 Web 界面端口
MONITOR_PORT=9090         # 本项目监控控制台端口

# 引擎路由前缀（官方默认 /music）
ENGINE_PREFIX=/music

# 调度器心跳（秒）：越大越省资源，越小发现新歌越快
TICK_SECONDS=60

# 并发下载数
DOWNLOAD_CONCURRENCY=3

# 默认目标音质：standard | high | lossless | hires
#   standard  ≈ 128kbps
#   high      ≈ 320kbps
#   lossless  ≈ FLAC 无损（需要对应平台会员 Cookie，否则会降级）
#   hires     ≈ Hi-Res 24bit（绝大多数情况无法满足，会自动降级）
DEFAULT_QUALITY=lossless

# 时区
TZ=Asia/Shanghai
